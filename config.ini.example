[base]
report_title =
input_pattern = *.xlsx
output_dir = output
intel_file = intel.csv

[network]
# 内网网段（CIDR，每行一个）
ranges =

# 内网区域关键词（逗号分隔）——已由程序从安全告警"源区域"列自动提取，留空即可
internal_zones =

# 本地归属地关键词（逗号分隔）——已由程序从安全告警"源地理信息"列自动提取（吉林-长春→长春）
local_geos = 本地

# 本地公网IP（逗号分隔）——已由程序从 业务ip.xlsx 自动加载，留空即可
excluded_ips =

[health]
# 探针配置（每行一个，格式：名称|IP）
probes =
log_retention_days =

[report]
top_events =
critical_levels =
ban_levels =

[update]
# 可选：自定义更新源（内网部署用）。留空/删段则使用内置 GitHub 源。
# version_urls 支持 http(s) 与本地/共享路径；exe_urls 支持 {version} 占位符
# 示例：
# version_urls =
#   http://intranet-server/apps/report/version.json
#   \\\\file-server\\share\\report\\version.json
# exe_urls =
#   http://intranet-server/apps/report/daily-report-{version}.exe

[intel]
# 可选：威胁情报库（threat_db.json）下载地址。留空/删段则使用内置 GitHub 固定地址
# （https://github.com/eavil666/dayupdate/releases/download/threat-intel-latest/threat_db.json）
# 内网部署时可指向内网镜像/共享路径，例如：
# db_url =
#   http://intranet-server/apps/report/threat_db.json
db_url =
