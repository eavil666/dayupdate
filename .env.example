# GitHub Personal Access Token（发布 Release 必需）
# 生成地址: https://github.com/settings/tokens
# 权限: 勾选 repo（完整仓库访问）
# 格式: ghp_ 开头的 40 位字符串
GH_TOKEN=ghp_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# 可选: 备用 Token（GH_TOKEN 失效时自动回退）
# GITHUB_TOKEN=ghp_yyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyy

# 可选: 指定默认发布版本号（留空则从 main.py 读取 APP_VERSION）
# RELEASE_VERSION=
